# Server port (Render automatically injects PORT in production)
PORT=3000

# Secret used to sign HTTP-only session cookies.
# On Render, configure this as a Secret or use render.yaml generateValue: true.
AUTH_SECRET="replace-with-a-long-random-secret-before-deploying"

# Optional override: salted scrypt hash of DD-MM-YYYY birthday password.
# Leave unset to use the built-in birthday date hash, or set BIRTHDAY_DATE_HASH + BIRTHDAY_DATE_SALT.
# BIRTHDAY_DATE_SALT=""
# BIRTHDAY_DATE_HASH=""

# Optional custom app URL
APP_URL="http://localhost:3000"
